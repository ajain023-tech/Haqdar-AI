# --- Database (Supabase / Neon / local docker) ---
DATABASE_URL=postgresql://haqdar:haqdar@localhost:5432/haqdar

# --- Cache + rate limit (Upstash Redis free tier; leave empty for in-memory) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM + embeddings (Gemini free tier). Empty key => offline fake providers (tests/dev only) ---
GEMINI_API_KEY=
LLM_PROVIDER=gemini            # gemini | fake
LLM_MODEL=gemini-2.5-flash
EMBED_PROVIDER=gemini          # gemini | hash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# --- Reranker (bge-reranker-v2-m3 on a Hugging Face Space; empty => LLM fallback) ---
RERANKER_URL=
RERANKER_TOKEN=
RERANK_PROVIDER=space          # space | llm | lexical | none
IDK_THRESHOLD=0.15             # top reranker score below this => "couldn't find"

# --- Tracing (Langfuse cloud free; empty => no-op) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API ---
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=30
CACHE_TTL_SECONDS=86400
